(function () {
    var ADDON_PORT = '11471';
    var sorts = ['quality', 'seedsdesc', 'sizedesc', 'sizeasc', 'qualitythensize'];
    var qualityExclusions = ['4k', '1080p', '720p', '480p', 'rips', 'cam', 'unknown'];
    var languages = ['en', 'fr', 'es', 'de', 'it', 'pt', 'ru', 'in', 'nl', 'hu', 'la', 'multi'];

    function val(id) {
        var el = document.getElementById(id);
        return el ? el.value : '';
    }

    function isChecked(id) {
        var el = document.getElementById(id);
        return !!(el && el.checked);
    }

    function publicAddonOrigin() {
        return 'http://' + window.location.hostname + ':' + ADDON_PORT;
    }

    function buildManifest() {
        if (!document.getElementById('debrid')) {
            return { error: 'Waiting for the configure form to load…' };
        }

        var jackettHost = val('jackett-host');
        var jackettApi = val('jackett-api');
        var debridApi = val('debrid-api');
        var tmdbApi = val('tmdb-api');
        var jackett = document.getElementById('jackett') ? isChecked('jackett') : true;
        var debrid = isChecked('debrid');
        var metadataProvider = isChecked('tmdb') ? 'tmdb' : 'cinemeta';
        var selectedLanguages = [];
        var i;
        for (i = 0; i < languages.length; i++) {
            if (isChecked(languages[i])) {
                selectedLanguages.push(languages[i]);
            }
        }
        var getAllLanguages = isChecked('get-all-languages');
        var selectedQualityExclusion = [];
        for (i = 0; i < qualityExclusions.length; i++) {
            if (isChecked(qualityExclusions[i])) {
                selectedQualityExclusion.push(qualityExclusions[i]);
            }
        }
        var filter = 'quality';
        for (i = 0; i < sorts.length; i++) {
            if (isChecked(sorts[i])) {
                filter = sorts[i];
            }
        }
        var maxSize = val('maxSize');
        var resultsPerQuality = val('resultsPerQuality');
        var maxResults = val('maxResults');
        if (maxSize === '' || isNaN(maxSize)) {
            maxSize = 0;
        }
        if (maxResults === '' || isNaN(maxResults)) {
            maxResults = 5;
        }
        if (resultsPerQuality === '' || isNaN(resultsPerQuality)) {
            resultsPerQuality = 1;
        }
        var exclusionKeywords = val('exclusion-keywords').split(',');
        var cleaned = [];
        for (i = 0; i < exclusionKeywords.length; i++) {
            var keyword = exclusionKeywords[i].replace(/^\s+|\s+$/g, '');
            if (keyword) {
                cleaned.push(keyword);
            }
        }

        if (jackett && (jackettHost === '' || jackettApi === '')) {
            return { error: 'Enter the Jackett URL and API key below. The addon URL will appear here.' };
        }
        if (debrid && debridApi === '') {
            return { error: 'Enter a debrid API key below, or turn off Enable Debrid Service. The addon URL will appear here.' };
        }
        if (metadataProvider === 'tmdb' && tmdbApi === '') {
            return { error: 'Enter a TMDB API key below, or choose Cinemeta. The addon URL will appear here.' };
        }
        if (selectedLanguages.length === 0 && !getAllLanguages) {
            return { error: 'Select at least one language below, or enable Select All Languages. The addon URL will appear here.' };
        }

        var data = {
            addonHost: publicAddonOrigin(),
            jackettHost: jackettHost,
            jackettApiKey: jackettApi,
            service: val('service') || 'realdebrid',
            debridKey: debridApi,
            maxSize: maxSize,
            exclusionKeywords: cleaned,
            languages: selectedLanguages,
            getAllLanguages: getAllLanguages,
            sort: filter,
            resultsPerQuality: resultsPerQuality,
            maxResults: maxResults,
            exclusion: selectedQualityExclusion,
            tmdbApi: tmdbApi,
            jackett: jackett,
            cache: isChecked('cache'),
            torrenting: isChecked('torrenting'),
            debrid: debrid,
            metadataProvider: metadataProvider
        };
        return { url: publicAddonOrigin() + '/' + btoa(JSON.stringify(data)) + '/manifest.json' };
    }

    function ensureBox() {
        var box = document.getElementById('umbrel-manifest-box');
        if (box) {
            return box;
        }
        box = document.createElement('div');
        box.id = 'umbrel-manifest-box';
        box.style.cssText = 'position:sticky;top:0;z-index:2147483647;margin:0;padding:16px;background:#4f46e5;color:#fff;font-family:-apple-system,BlinkMacSystemFont,sans-serif;';

        var title = document.createElement('div');
        title.style.cssText = 'font-size:18px;font-weight:700;margin:0 0 8px 0;';
        title.textContent = 'Addon URL — select the text, copy it, paste it in Stremio Addons';
        box.appendChild(title);

        var urlText = document.createElement('div');
        urlText.id = 'umbrel-manifest-url';
        urlText.style.cssText = 'padding:12px;background:#1e1b4b;color:#e0e7ff;font-size:14px;line-height:1.5;word-break:break-all;-webkit-user-select:text;user-select:text;-webkit-touch-callout:default;';
        box.appendChild(urlText);

        var hint = document.createElement('div');
        hint.style.cssText = 'margin-top:8px;font-size:13px;opacity:0.9;';
        hint.textContent = 'Copy and Install do not work in Safari or the Stremio app. Use this URL.';
        box.appendChild(hint);

        if (document.body) {
            document.body.insertBefore(box, document.body.firstChild);
        }
        return box;
    }

    function refresh() {
        if (!document.body) {
            return;
        }
        ensureBox();
        var urlText = document.getElementById('umbrel-manifest-url');
        if (!urlText) {
            return;
        }
        var result = buildManifest();
        urlText.textContent = result.url || result.error;
        urlText.style.color = result.url ? '#e0e7ff' : '#fde68a';
    }

    window.getLink = function () {
        refresh();
        var box = document.getElementById('umbrel-manifest-box');
        if (box) {
            box.scrollIntoView(true);
        }
        return false;
    };

    function start() {
        var jackettHost = document.getElementById('jackett-host');
        if (jackettHost && jackettHost.value === '') {
            jackettHost.value = 'http://jackett_server_1:9117';
        }
        refresh();
        document.addEventListener('input', refresh, true);
        document.addEventListener('change', refresh, true);
        document.addEventListener('click', function () {
            setTimeout(refresh, 0);
        }, true);
        setInterval(refresh, 1000);
    }

    if (document.body) {
        start();
    } else {
        document.addEventListener('DOMContentLoaded', start);
    }
})();
