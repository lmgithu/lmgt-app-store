const sorts = ['quality', 'seedsdesc', 'sizedesc', 'sizeasc', 'qualitythensize'];
const qualityExclusions = ['4k', '1080p', '720p', '480p', 'rips', 'cam', 'unknown'];
const languages = ['en', 'fr', 'es', 'de', 'it', 'pt', 'ru', 'in', 'nl', 'hu', 'la', 'multi'];
const ADDON_PORT = '11471';

document.addEventListener('DOMContentLoaded', function () {
    updateProviderFields();
    const jackettHost = document.getElementById('jackett-host');
    if (jackettHost && jackettHost.value === '') {
        jackettHost.value = 'http://jackett_server_1:9117';
    }
    var installBtn = document.getElementById('install');
    if (installBtn) {
        installBtn.textContent = 'Show addon URL';
    }
    var copyBtn = document.getElementById('copy');
    if (copyBtn) {
        copyBtn.style.display = 'none';
    }
    ensureManifestBox();
    refreshManifestUrl();
    document.addEventListener('input', refreshManifestUrl);
    document.addEventListener('change', refreshManifestUrl);
    document.addEventListener('click', function () {
        setTimeout(refreshManifestUrl, 0);
    });
});

function setElementDisplay(elementId, displayStatus) {
    const element = document.getElementById(elementId);
    if (!element) {
        return;
    }
    element.style.display = displayStatus;
}

function updateProviderFields(isChangeEvent = false) {
    if (document.getElementById('debrid').checked) {
        setElementDisplay('debrid-fields', 'block');
    } else {
        setElementDisplay('debrid-fields', 'none');
    }
    if (document.getElementById('jackett')?.checked) {
        setElementDisplay('jackett-fields', 'block');
    } else {
        setElementDisplay('jackett-fields', 'none');
    }
    if (document.getElementById('tmdb')?.checked) {
        setElementDisplay('tmdb-fields', 'block');
    } else {
        setElementDisplay('tmdb-fields', 'none');
    }
    if (!document.getElementById('get-all-languages')?.checked) {
        setElementDisplay('languages-fields', 'block');
    } else {
        setElementDisplay('languages-fields', 'none');
    }
}

function loadData() {
    const currentUrl = window.location.href;
    let data = currentUrl.match(/\/([^\/]+)\/configure$/);
    if (data && data[1].startsWith("ey")) {
        data = atob(data[1]);
        data = JSON.parse(data);
        if (document.getElementById('jackett-fields')) {
            document.getElementById('jackett-host').value = data.jackettHost;
            document.getElementById('jackett-api').value = data.jackettApiKey;
        }
        document.getElementById('debrid-api').value = data.debridKey;
        document.getElementById('tmdb-api').value = data.tmdbApi;
        document.getElementById('service').value = data.service;
        document.getElementById('exclusion-keywords').value = (data.exclusionKeywords || []).join(', ');
        document.getElementById('maxSize').value = data.maxSize;
        document.getElementById('resultsPerQuality').value = data.resultsPerQuality;
        document.getElementById('maxResults').value = data.maxResults;
        if (document.getElementById('jackett')) {
            document.getElementById('jackett').checked = data.jackett;
        }
        if (document.getElementById('cache')) {
            document.getElementById('cache').checked = data.cache;
        }
        document.getElementById('torrenting').checked = data.torrenting;
        document.getElementById('debrid').checked = data.debrid;
        document.getElementById('tmdb').checked = data.metadataProvider === 'tmdb';
        document.getElementById('cinemeta').checked = data.metadataProvider === 'cinemeta';

        sorts.forEach(sort => {
            if (data.sort === sort) {
                document.getElementById(sort).checked = true;
            }
        });

        qualityExclusions.forEach(quality => {
            if (data.exclusion.includes(quality)) {
                document.getElementById(quality).checked = true;
            }
        })

        languages.forEach(language => {
            if (data.languages.includes(language)) {
                document.getElementById(language).checked = true;
            }
        });

        document.getElementById('get-all-languages').checked = data.getAllLanguages;
    }
}

let showLanguageCheckBoxes = true;

function showCheckboxes() {
    let checkboxes = document.getElementById("languageCheckBoxes");

    if (showLanguageCheckBoxes) {
        checkboxes.style.display = "block";
        showLanguageCheckBoxes = false;
    } else {
        checkboxes.style.display = "none";
        showLanguageCheckBoxes = true;
    }
}

loadData();

function publicAddonOrigin() {
    const hostname = new URL(window.location.href).hostname;
    return 'http://' + hostname + ':' + ADDON_PORT;
}

function val(id) {
    var el = document.getElementById(id);
    if (!el) {
        return '';
    }
    return el.value;
}

function checked(id) {
    var el = document.getElementById(id);
    return !!(el && el.checked);
}

function buildManifest() {
    var debridEl = document.getElementById('debrid');
    if (!debridEl) {
        return { error: 'Page is still loading.' };
    }

    var addonHost = publicAddonOrigin();
    var jackettHost = val('jackett-host');
    var jackettApi = val('jackett-api');
    var debridApi = val('debrid-api');
    var tmdbApi = val('tmdb-api');
    var service = val('service') || 'realdebrid';
    var exclusionKeywords = val('exclusion-keywords').split(',').map(function (keyword) {
        return keyword.trim();
    }).filter(function (keyword) {
        return keyword !== '';
    });
    var maxSize = val('maxSize');
    var resultsPerQuality = val('resultsPerQuality');
    var maxResults = val('maxResults');
    var jackett = checked('jackett');
    var cache = checked('cache');
    var torrenting = checked('torrenting');
    var debrid = checked('debrid');
    var metadataProvider = checked('tmdb') ? 'tmdb' : 'cinemeta';
    var selectedQualityExclusion = [];
    qualityExclusions.forEach(function (quality) {
        if (checked(quality)) {
            selectedQualityExclusion.push(quality);
        }
    });
    var selectedLanguages = [];
    languages.forEach(function (language) {
        if (checked(language)) {
            selectedLanguages.push(language);
        }
    });
    var getAllLanguages = checked('get-all-languages');
    var filter = 'quality';
    sorts.forEach(function (sort) {
        if (checked(sort)) {
            filter = sort;
        }
    });
    if (maxSize === '' || isNaN(maxSize)) {
        maxSize = 0;
    }
    if (maxResults === '' || isNaN(maxResults)) {
        maxResults = 5;
    }
    if (resultsPerQuality === '' || isNaN(resultsPerQuality)) {
        resultsPerQuality = 1;
    }

    if (jackett && (jackettHost === '' || jackettApi === '')) {
        return { error: 'Enter the Jackett URL and API key. The addon URL will appear here.' };
    }
    if (debrid && debridApi === '') {
        return { error: 'Enter a debrid API key, or turn off Enable Debrid Service.' };
    }
    if (metadataProvider === 'tmdb' && tmdbApi === '') {
        return { error: 'Enter a TMDB API key, or choose Cinemeta.' };
    }
    if (selectedLanguages.length === 0 && !getAllLanguages) {
        return { error: 'Select at least one language, or enable Select All Languages.' };
    }

    var data = {
        addonHost: addonHost,
        jackettHost: jackettHost,
        jackettApiKey: jackettApi,
        service: service,
        debridKey: debridApi,
        maxSize: maxSize,
        exclusionKeywords: exclusionKeywords,
        languages: selectedLanguages,
        getAllLanguages: getAllLanguages,
        sort: filter,
        resultsPerQuality: resultsPerQuality,
        maxResults: maxResults,
        exclusion: selectedQualityExclusion,
        tmdbApi: tmdbApi,
        jackett: jackett,
        cache: cache,
        torrenting: torrenting,
        debrid: debrid,
        metadataProvider: metadataProvider
    };
    return { url: addonHost + '/' + btoa(JSON.stringify(data)) + '/manifest.json' };
}

function ensureManifestBox() {
    var box = document.getElementById('umbrel-manifest-box');
    if (box) {
        return box;
    }
    box = document.createElement('div');
    box.id = 'umbrel-manifest-box';
    box.style.cssText = 'margin:0 0 24px 0;padding:16px;border-radius:12px;background:rgba(15,23,42,0.95);border:1px solid #6366f1;';

    var label = document.createElement('p');
    label.style.cssText = 'margin:0 0 10px 0;color:#e2e8f0;font-size:15px;font-weight:600;';
    label.textContent = 'Addon URL — select the text below and copy it, then paste it in Stremio Addons.';
    box.appendChild(label);

    var urlText = document.createElement('p');
    urlText.id = 'umbrel-manifest-url';
    urlText.style.cssText = 'margin:0;padding:12px;border-radius:8px;background:#0f172a;color:#a5b4fc;font-size:14px;line-height:1.5;word-break:break-all;-webkit-user-select:text;user-select:text;-webkit-touch-callout:default;';
    box.appendChild(urlText);

    var link = document.createElement('a');
    link.id = 'umbrel-manifest-link';
    link.style.cssText = 'display:none;margin-top:10px;color:#c7d2fe;font-size:14px;word-break:break-all;';
    link.textContent = 'Long-press this link to copy';
    box.appendChild(link);

    var form = document.querySelector('form');
    if (form && form.parentNode) {
        form.parentNode.insertBefore(box, form);
    } else {
        document.body.insertBefore(box, document.body.firstChild);
    }
    return box;
}

function refreshManifestUrl() {
    var box = ensureManifestBox();
    var urlText = document.getElementById('umbrel-manifest-url');
    var link = document.getElementById('umbrel-manifest-link');
    var result = buildManifest();
    if (result.error) {
        urlText.textContent = result.error;
        urlText.style.color = '#fde68a';
        link.style.display = 'none';
        link.removeAttribute('href');
        return;
    }
    urlText.textContent = result.url;
    urlText.style.color = '#a5b4fc';
    link.href = result.url;
    link.style.display = 'inline-block';
}

function getLink(method) {
    refreshManifestUrl();
    var box = document.getElementById('umbrel-manifest-box');
    if (box) {
        box.scrollIntoView({ block: 'start' });
    }
}
