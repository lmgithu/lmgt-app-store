#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"

# Docker creates a directory if a file bind-mount is missing.
for path in \
  "${APP_DIR}/nginx.conf" \
  "${APP_DIR}/addon-url.js" \
  "${APP_DIR}/config.js"
do
  if [ -d "${path}" ]; then
    rm -rf "${path}"
  fi
done

if [ ! -f "${APP_DIR}/addon-url.js" ] && [ -f "${APP_DIR}/addon-url.js.template" ]; then
  cp "${APP_DIR}/addon-url.js.template" "${APP_DIR}/addon-url.js"
fi

cat > "${APP_DIR}/nginx.conf" << 'NGINX'
server {
    listen 80;
    server_name _;

    location = /umbrel-addon-url.js {
        alias /umbrel/addon-url.js;
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Access-Control-Allow-Origin *;
    }

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        sub_filter '</body>' '<script src="/umbrel-addon-url.js"></script></body>';
        sub_filter '</BODY>' '<script src="/umbrel-addon-url.js"></script></body>';
        sub_filter_types text/html;
        sub_filter_once on;
    }
}
NGINX
